# Paper trading desk — NO wallet private keys. Paper mode only.

# Optional: xAI Grok for ANALYST (rule-based fallback if unset)
XAI_API_KEY=

# Optional: Solana RPC for mint/freeze authority & holder data (reject if checks need it)
SOLANA_RPC_URL=

# Starting paper equity (USD)
STARTING_BALANCE=280.0

# Cycle interval seconds
CYCLE_INTERVAL_SEC=60

# Analyst minimum score to trade
ANALYST_MIN_SCORE=0.6

# ----- Volume lag trap fix (smarter activity gate) -----
# Absolute floor replaced by configurable lower floor + relative metrics
ACTIVITY_MIN_VOLUME_USD_H1=8000
ACTIVITY_MIN_VOL_TO_LIQ_RATIO=0.15
ACTIVITY_MAX_BUY_SELL_RATIO=4.0
ACTIVITY_MIN_UNIQUE_BUYERS=25
ACTIVITY_MAX_PRICE_ABOVE_RECENT_LOW_PCT=0.45

# Legacy hard gate from blueprint (disabled by default; use activity gate instead)
FILTER_USE_LEGACY_50K_VOLUME=false

# ----- Stop-loss whipsaw fix -----
RISK_STOP_EVAL_MODE=twap
RISK_TWAP_WINDOW_SEC=60
RISK_EXIT_SLIPPAGE_BPS=250
RISK_HARD_STOP_PCT=0.06
RISK_TRAIL_TRIGGER_PCT=0.12
RISK_TRAIL_DRAWDOWN_PCT=0.06

# ----- Holder cluster fix -----
CLUSTER_CHECK_REQUIRED=true
CLUSTER_MAX_FRESH_WALLETS_PCT=0.25
CLUSTER_MAX_SHARED_FUNDING_GROUPS=3
CLUSTER_WALLET_AGE_MAX_HOURS=48

# Position sizing
POSITION_SIZE_PCT=0.08
ENTRY_SLIPPAGE_BPS=150

# Database path
SQLITE_PATH=./data/desk.sqlite

# Replay snapshots directory
REPLAY_SNAPSHOTS_DIR=./fixtures/replay